{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "Atoolkit/**/*.ts",
    "_old/**/*.ts",
    "WeebRender/**/*.ts",
    "prototypes/Akettle/**/*.ts",
    "prototypes/AwgpuShadowDemo/**/*.ts",
    "prototypes/SuperSimple/**/*.ts",
    "prototypes/RttCube/**/*.ts",
    "hub/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".tsc-dist", ".vite", "**/*.config.ts"]
}
